  "deviations": [
    {
      "achieved": "statistical",
      "declared": "train",
      "description": "default: test predictions after the seeded short training",
      "detail": "",
      "explanation": "A linear bias in front of a batch norm layer has an exactly zero gradient, so what Adam sees is float32 rounding noise, and Adam rescales it to a full learning-rate step. The scaled expression differs by one float32 rounding (about 5e-7) between 1.6.1 and v2, which is enough to send that bias, the running means behind it and, through them, the eval-mode predictions of a 3-epoch fit to a different place. Measured on 2026-10-23: training 1.6.1 itself on expression scaled by 1 + 3e-7 moves its test predictions by 2.2e-4 (default) and 2.2e-3 (no_es), against 1.0e-3 and 1.6e-3 between 1.6.1 and v2. Every other parameter and the batch-norm-free variant agree at the train class.",
      "max_abs_diff": 0.0010439008474349976,
