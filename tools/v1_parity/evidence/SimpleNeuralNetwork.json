  "deviations": [
    {
      "achieved": "statistical",
      "declared": "train",
      "description": "default: fully_connected_layers.0.bias after training",
      "detail": "",
      "explanation": "A linear bias in front of a batch norm layer has an exactly zero gradient, so what Adam sees is float32 rounding noise, and Adam rescales it to a full learning-rate step (the same mechanism as in the PaccMann case). The running mean behind that bias, and through it the eval-mode predictions, inherit the drift: the EMA has not yet forgotten the bias after a few steps. The weights, the batch norm scale and the second layer do not depend on the bias in train mode and agree at the `train` class. Variants without a batch norm layer in the forward path (a single hidden layer: 1.6.1 and v2 both skip it) reproduce the predictions. Measured on 2026-10-23 (variant `default`): training v2 itself on expression scaled by 1 + 3e-7 moves its test predictions by 6.0e-4, the bias by 6.1e-3 and the running mean by 3.2e-3, against 5.0e-4, 4.3e-3 and 1.6e-3 between 1.6.1 and v2.",
      "max_abs_diff": 0.004308862145990133,
